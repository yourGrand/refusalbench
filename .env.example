# copy this file to .env in the repo root and fill in values
# .env is gitignored and must never be committed

# recommended: bedrock api key (bearer auth, no access key pair)
AWS_BEARER_TOKEN=your-bedrock-api-key

# optional alias used by litellm/boto3 (auto-filled from AWS_BEARER_TOKEN if omitted)
# AWS_BEARER_TOKEN_BEDROCK=

# alternative auth (pick one approach)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=your-sso-profile

AWS_REGION=us-east-1

# litellm model string = bedrock/converse/ + bedrock model or inference profile id
# bedrock/ selects amazon bedrock; converse/ uses the Converse API (recommended for judges)
#
# newer anthropic models (sonnet 4+, sonnet 4.5, sonnet 5) often reject the bare foundation
# model id (anthropic.claude-...-v1:0). use the inference profile id from the console instead,
# usually prefixed with global. or us. (copy the full id shown for "inference profile").
# example that works when global profile is enabled:
REFUSALBENCH_JUDGE_SONNET4_5=bedrock/converse/
REFUSALBENCH_JUDGE_MISTRAL_LARGE_3=bedrock/converse/
REFUSALBENCH_JUDGE_NEMOTRON_3_SUPER=bedrock/converse/
